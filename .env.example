# ==========================================
# Healthy Worm - Environment Configuration
# ==========================================

# 1. Admin Dashboard Authentication
ADMIN_PASSWORD=your_secure_admin_password_here

# 2. Site URL (used for building links in emails)
NEXT_PUBLIC_SITE_URL=https://healthyworm.com

# 3. Built-in Email Delivery & Standard SMTP Configuration
# No external marketing services required!
# Provide your standard SMTP credentials (works with Gmail, custom cPanel mail, Postfix, etc.):
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_specific_password_here
SMTP_FROM_EMAIL=newsletter@healthyworm.com
SMTP_FROM_NAME="Healthy Worm"

# Note: If SMTP credentials are not provided, the built-in delivery engine operates
# in self-hosted local mode, saving dispatched emails and attachments directly to
# data/email_outbox.json for instant inspection in the Admin Dashboard!

# 4. Ebook PDF Storage & Delivery (Optional)
# Leave empty to serve the local high-protein recipe ebook generated in data/ebooks/
# Or provide an external URL:
# EBOOK_DOWNLOAD_URL=https://your-bucket.s3.amazonaws.com/10-healthy-high-protein-recipes.pdf
